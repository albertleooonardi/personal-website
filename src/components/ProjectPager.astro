---
// Previous and next projects. Hovering either one floats a small preview card
// that follows the pointer.
import NightArt from './NightArt.astro';
import type { Project } from '../data/projects';

interface Props {
  prev: Project;
  next: Project;
}

const { prev, next } = Astro.props;
const entries = [
  { project: prev, back: true },
  { project: next, back: false },
];
---

<nav class="pager" aria-label="More projects">
  {
    entries.map(({ project, back }) => (
      <a class:list={['link', { back }]} href={`/projects/${project.slug}`} data-pager-link>
        <span class="which">{back ? 'previous' : 'next'}</span>
        <span class="title">{back ? `← ${project.name}` : `${project.name} →`}</span>
        <span class="preview" aria-hidden="true" data-preview>
          <span class="preview-art">
            <NightArt seed={project.art} src={project.thumb} width={900} height={600} />
          </span>
          <span class="preview-meta">
            <span class="preview-name">{project.name}</span>
            <span class="preview-year">{project.year}</span>
          </span>
          {project.page?.tagline && <span class="preview-tagline">{project.page.tagline}</span>}
        </span>
      </a>
    ))
  }
</nav>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  for (const link of document.querySelectorAll<HTMLElement>('[data-pager-link]')) {
    const card = link.querySelector<HTMLElement>('[data-preview]');
    if (!card) continue;
    const pos = { x: 0, y: 0, tx: 0, ty: 0, raf: 0 };

    const aim = (x: number, y: number) => {
      pos.tx = Math.max(12, Math.min(innerWidth - card.offsetWidth - 12, x - card.offsetWidth / 2));
      pos.ty = y - card.offsetHeight - 18 < 12 ? y + 18 : y - card.offsetHeight - 18;
    };
    const paint = () => {
      card.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
    };
    const follow = () => {
      pos.x += (pos.tx - pos.x) * 0.25;
      pos.y += (pos.ty - pos.y) * 0.25;
      paint();
      pos.raf = Math.abs(pos.tx - pos.x) + Math.abs(pos.ty - pos.y) > 0.5 ? requestAnimationFrame(follow) : 0;
    };
    const jump = (x: number, y: number) => {
      aim(x, y);
      pos.x = pos.tx;
      pos.y = pos.ty;
      paint();
    };

    link.addEventListener('pointerenter', (e) => jump(e.clientX, e.clientY));
    link.addEventListener('pointermove', (e) => {
      if (still.matches) return jump(e.clientX, e.clientY);
      aim(e.clientX, e.clientY);
      if (!pos.raf) pos.raf = requestAnimationFrame(follow);
    });
    link.addEventListener('focus', () => {
      const r = link.getBoundingClientRect();
      jump(r.left + r.width / 2, r.top);
    });
  }
</script>

<style>
  .pager {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-top: 96px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .link {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    text-align: right;
    text-decoration: none;
    outline: none;
  }

  .link.back {
    align-items: flex-start;
    text-align: left;
  }

  .which {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .title {
    font-size: 17px;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .link:hover .title,
  .link:focus-visible .title {
    text-decoration-line: underline;
  }

  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    display: block;
    width: 17rem;
    padding: 6px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    text-align: left;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s, visibility 0s 0.15s;
  }

  @media (hover: hover) and (pointer: fine) {
    .link:hover .preview,
    .link:focus-visible .preview {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.15s;
    }
  }

  .preview-art {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 4px;
  }

  .preview-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 8px;
    padding: 0 4px;
  }

  .preview-name {
    font-size: 15px;
  }

  .preview-year {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .preview-tagline {
    display: block;
    margin-top: 2px;
    padding: 0 4px 4px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
