---
import Base from '../../layouts/Base.astro';
import NightArt from '../../components/NightArt.astro';
import Parts from '../../components/Parts.astro';
import ProjectPager from '../../components/ProjectPager.astro';
import StoryGallery from '../../components/StoryGallery.astro';
import { isExternal, projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.filter((p) => p.page).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const page = project.page!;
const withPages = projects.filter((p) => p.page);
const index = withPages.findIndex((p) => p.slug === project.slug);
const prev = withPages[(index - 1 + withPages.length) % withPages.length];
const next = withPages[(index + 1) % withPages.length];
const host = project.link && isExternal(project.link) ? new URL(project.link).hostname.replace(/^www\./, '') : null;
---

<Base title={project.name} description={page.tagline}>
  <div class="cover" data-cover>
    <NightArt seed={project.art * 7 + 3} src={page.cover} width={2400} height={560} variant="meadow" eager />
  </div>

  <main class="case" data-slug={project.slug}>
    <header>
      <a class="back" href="/projects">← Projects</a>
      <h1>{project.name}</h1>
      <p class="tagline">{page.tagline}</p>
      <p class="about"><Parts parts={page.about} /></p>
      {
        (host || project.repo) && (
          <p class="site">
            {host && (
              <a class="ink-link" href={project.link} target="_blank" rel="noopener noreferrer">live site ↗</a>
            )}
            {project.repo && (
              <a class="ink-link" href={project.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            )}
          </p>
        )
      }
      {project.tech.length > 0 && (
        <ul class="tech" aria-label="Technologies">
          {project.tech.map((name) => <li>{name}</li>)}
        </ul>
      )}
    </header>

    <div class="poster">
      {
        page.video ? (
          <video src={page.video} poster={page.poster} autoplay muted loop playsinline preload="metadata" aria-label={`${project.name} demo`} data-motion-video />
        ) : (
          <NightArt
            seed={project.art}
            src={page.poster}
            alt={`${project.name}, ${page.tagline}`}
            width={1600}
            height={900}
            label={page.poster ? undefined : project.name}
            eager
          />
        )
      }
    </div>

    {
      page.story && (
        <div class="story">
          {page.story.map((block) => {
            if (block.kind === 'heading') return <h2>{block.text}</h2>;
            if (block.kind === 'text')
              return (
                <p>
                  <Parts parts={block.parts} />
                </p>
              );
            if (block.kind === 'gallery') return <StoryGallery title={block.title} shots={block.shots} start={block.start} />;
            if (block.kind === 'image')
              return (
                <div class="image">
                  <NightArt seed={block.art ?? 1} src={block.src} alt={block.alt} width={1600} height={900} />
                </div>
              );
            return (
              <figure class="clip">
                <video src={block.src} poster={block.poster} autoplay muted loop playsinline preload="metadata" aria-label={block.label} data-motion-video />
                <figcaption>{block.label}</figcaption>
              </figure>
            );
          })}
        </div>
      )
    }

    {withPages.length > 1 && <ProjectPager prev={prev} next={next} />}
  </main>
</Base>

<script>
  const main = document.querySelector<HTMLElement>('[data-slug]');
  try {
    if (main?.dataset.slug) sessionStorage.setItem('projects-last-viewed', main.dataset.slug);
  } catch {}

  // Light nav text while it sits over the dark cover.
  const cover = document.querySelector<HTMLElement>('[data-cover]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (cover && nav) {
    const update = () => nav.classList.toggle('over-cover', cover.getBoundingClientRect().bottom > 56);
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }

  // Videos autoplay, unless motion is reduced: then they wait with controls.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const video of document.querySelectorAll<HTMLVideoElement>('[data-motion-video]')) {
      video.pause();
      video.autoplay = false;
      video.controls = true;
    }
  }
</script>

<style>
  .cover {
    position: relative;
    height: clamp(180px, 26vw, 440px);
    overflow: hidden;
  }

  .cover::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }

  .case {
    max-width: 56rem;
    margin: 0 auto;
    padding: 56px var(--gutter) 160px;
    font-family: var(--font-serif);
    box-sizing: content-box;
  }

  .back {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--fg);
  }

  h1 {
    margin-top: 40px;
    font-size: 34px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .tagline {
    margin-top: 4px;
    font-size: 19px;
    font-style: italic;
    color: var(--muted);
  }

  .about,
  .story p {
    font-size: 18px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .about {
    margin-top: 32px;
  }

  .site {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .tech li {
    padding: 4px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .poster,
  .image,
  .clip video {
    overflow: hidden;
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--line);
  }

  .poster {
    margin-top: 64px;
    aspect-ratio: 16 / 9;
  }

  .poster :global(img.art),
  .image :global(img.art) {
    object-fit: contain;
    background: #171c20;
  }

  .poster video,
  .clip video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .story {
    display: flex;
    flex-direction: column;
    margin-top: 96px;
  }

  .story h2 {
    margin-bottom: 12px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.5;
  }

  .story h2:not(:first-child) {
    margin-top: 64px;
  }

  .story p {
    color: color-mix(in srgb, var(--fg) 78%, transparent);
  }

  .story p + p {
    margin-top: 20px;
  }

  .image {
    margin: 24px 0;
    aspect-ratio: 16 / 9;
  }

  .clip {
    margin: 48px 0;
  }

  .clip figcaption {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .cover {
      margin-top: 80px;
    }

    .case {
      padding-top: 40px;
    }

    h1 {
      font-size: 30px;
    }
  }
</style>
